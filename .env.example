# =============================================================================
# LLM Gateway — environment configuration
# Copy to `.env` and edit. NEVER commit a real `.env`.
# =============================================================================

# --- app ----------------------------------------------------------------------
APP_ENV=development                 # development | production | test
LOG_LEVEL=INFO
ADMIN_TOKEN=change-me-admin-token   # required in production; gates /admin/*
PUBLIC_BASE_URL=http://localhost:8000

# --- database -----------------------------------------------------------------
# dev: SQLite (zero install). prod: Postgres.
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# --- redis --------------------------------------------------------------------
# MUST be reachable from Windows. Inside WSL, bind redis to 0.0.0.0 or this fails silently.
REDIS_URL=redis://localhost:6379/0

# --- upstream (Ollama runs NATIVELY on Windows for GPU access) ----------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
UPSTREAM_TIMEOUT_S=60
UPSTREAM_IDLE_TIMEOUT_S=30          # abort if no SSE chunk arrives for this long
CIRCUIT_FAILURE_THRESHOLD=5         # consecutive failures to open the circuit
CIRCUIT_COOLDOWN_S=30               # half-open after this; exactly 1 probe allowed
RETRY_MAX_ATTEMPTS=2                # retries ONLY 429/5xx/timeout, with jitter

# logical model -> upstream model. "auto" is resolved by the router.
MODEL_MAP={"fast":"llama3.2:3b","smart":"llama3.2:3b","coder":"llama3.2:3b","auto":"llama3.2:3b"}

# --- exact cache --------------------------------------------------------------
EXACT_CACHE_ENABLED=true
EXACT_CACHE_TTL_S=86400
EXACT_CACHE_MAX_ENTRIES=10000       # LRU cap

# --- semantic cache -----------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_S=604800         # 7 days
SEMANTIC_SIM_THRESHOLD=0.92         # swept on Day 2 -> ml/artifacts/threshold.json
SEMANTIC_MARGIN_GUARD=0.02          # top1 - top2 minimum; false-positive guard
SEMANTIC_MAX_VECTORS=50000          # above this, switch to pgvector
EMBED_PROVIDER=fastembed            # fastembed (in-process, no torch) | ollama
CACHE_MAX_TEMP=0.2                  # temperature above this -> bypass cache

# --- rate limiting (TOKEN denominated, not requests) --------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100000          # tokens
RATE_LIMIT_REFILL_PER_S=1666        # ~100k/min
RATE_LIMIT_WEIGHT_PROMPT=1.0
RATE_LIMIT_WEIGHT_COMPLETION=1.0
CONCURRENCY_LIMIT_PER_KEY=8         # in-flight streams

# --- telemetry (never blocks the hot path) ------------------------------------
LOG_QUEUE_MAXSIZE=10000             # drop-on-full, counted
LOG_FLUSH_INTERVAL_S=1.0
LOG_FLUSH_BATCH=500
PROMPT_PREVIEW_LEN=200              # truncated + PII-redacted
