# syntax=docker/dockerfile:1
# Build stage — compiles React while the full node toolchain is present.
# Build context is the REPO ROOT (see docker-compose.yml), so both
# dashboard/ sources and the root nginx.conf are reachable.
FROM node:22-slim AS build
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

# Serve stage — static files behind nginx, no node at runtime.
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
